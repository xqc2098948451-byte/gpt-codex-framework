{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gpt-codex/evidence-v1",
  "title": "GPT-Codex Evidence",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "kernel_version",
    "schema_version",
    "evidence_id",
    "project_id",
    "source",
    "subject",
    "state_revision",
    "result"
  ],
  "properties": {
    "kernel_version": {
      "const": "2.0.0"
    },
    "schema_version": {
      "const": 1
    },
    "source": {
      "enum": [
        "TOOL_OBSERVED",
        "USER_ASSERTED",
        "SYSTEM_DERIVED",
        "MODEL_INFERRED"
      ]
    },
    "state_revision": {
      "type": "integer",
      "minimum": 0
    },
    "result": {
      "type": "string"
    }
  }
}
