{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gpt-codex/result-envelope-v1",
  "title": "GPT-Codex Result Envelope",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "kernel_version",
    "schema_version",
    "project_id",
    "work_unit_id",
    "extension",
    "status",
    "evidence_refs",
    "completion_gate"
  ],
  "properties": {
    "kernel_version": {
      "const": "2.0.0"
    },
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "PARTIAL",
        "LOCAL_COMPLETE",
        "INCOMPLETE"
      ]
    },
    "return_to_gpt_required": {
      "type": "boolean"
    },
    "source_project_context_id": {
      "type": ["string", "null"]
    },
    "source_project_name": {
      "type": ["string", "null"]
    },
    "framework_version": {
      "type": ["string", "null"]
    },
    "result_message_type": {
      "type": "string",
      "enum": ["REVIEW_RESULT", "REVIEW_FINDING", "IMPLEMENTATION_RESULT", "INVALID_INSTRUCTION", "ROLE_AUTHORITY_CONFLICT", "APPROVAL_RESULT"]
    },
    "result_id": { "type": ["string", "null"], "minLength": 1 },
    "decision": { "type": ["string", "null"], "enum": ["APPROVE", "REJECT", null] },
    "approved_instruction": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "instruction_id": { "type": "string", "format": "uuid" },
        "expected_state_revision": { "type": "integer", "minimum": 0 },
        "expected_base_sha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
        "scope_paths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.?(?:/|$))(?!.*//).+$" } },
        "target_project_context_id": { "type": "string", "minLength": 1 },
        "target_project_name": { "type": "string", "minLength": 1 },
        "target_github_repository_id": { "type": "string", "minLength": 1 },
        "target_github_repository_full_name": { "type": "string", "minLength": 1 },
        "target_work_unit_ref": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "path": { "type": "string", "minLength": 1, "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.?(?:/|$))(?!.*//).+$" },
            "sha": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" }
          },
          "required": ["path", "sha"]
        },
        "issuer_role": { "const": "GPT_ORCHESTRATOR" },
        "executor_role": { "const": "CODEX_IMPLEMENTER" },
        "authorized_actions": { "type": "array", "minItems": 1, "items": { "type": "string" }, "contains": { "const": "MUTATE_APPROVED_SCOPE" } }
      },
      "required": ["instruction_id", "expected_state_revision", "expected_base_sha", "scope_paths", "target_project_context_id", "target_project_name", "target_github_repository_id", "target_github_repository_full_name", "target_work_unit_ref", "issuer_role", "executor_role", "authorized_actions"]
    },
    "response_to_instruction_id": { "type": ["string", "null"], "format": "uuid" },
    "responder_role": {
      "type": ["string", "null"],
      "enum": ["GPT_ORCHESTRATOR", "GPT_REVIEWER", "CODEX_IMPLEMENTER", "CODEX_REVIEWER", "USER_APPROVER", "USER_LOCAL", "INFORMATION_ONLY", null]
    },
    "return_role": {
      "type": ["string", "null"],
      "enum": ["GPT_ORCHESTRATOR", "GPT_REVIEWER", "CODEX_IMPLEMENTER", "CODEX_REVIEWER", "USER_APPROVER", "USER_LOCAL", "INFORMATION_ONLY", null]
    },
    "review_target_revision": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F]{40}$" },
    "finding_ids": { "type": ["array", "null"], "maxItems": 50, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "fix_round": { "type": ["integer", "null"], "minimum": 0 },
    "remediation_decision_ref": { "type": ["string", "null"], "minLength": 1 },
    "protocol_error": { "type": ["string", "null"], "enum": ["INVALID_INSTRUCTION", "ROLE_AUTHORITY_CONFLICT", null] },
    "role_observation": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "role": { "type": "string", "enum": ["GPT_ORCHESTRATOR", "GPT_REVIEWER", "CODEX_IMPLEMENTER", "CODEX_REVIEWER", "USER_APPROVER", "USER_LOCAL", "INFORMATION_ONLY"] },
        "instruction_id": { "type": "string", "format": "uuid" },
        "work_unit": { "type": "string", "minLength": 1 },
        "reviewed_revision": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F]{40}$" },
        "executed_revision": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F]{40}$" },
        "files_read": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1 } },
        "files_changed": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1 } },
        "tests_run": { "type": "array", "maxItems": 100, "items": { "type": ["string", "object"] } },
        "findings": { "type": "array", "maxItems": 50, "items": { "type": "string", "minLength": 1 } },
        "fix_round": { "type": "integer", "minimum": 0 },
        "agent_spawns": { "type": "integer", "minimum": 0 },
        "result": { "type": "string", "enum": ["REVIEW_RESULT", "REVIEW_FINDING", "IMPLEMENTATION_RESULT", "INVALID_INSTRUCTION", "ROLE_AUTHORITY_CONFLICT"] }
      },
      "required": ["role", "instruction_id", "work_unit", "reviewed_revision", "executed_revision", "files_read", "files_changed", "tests_run", "findings", "fix_round", "agent_spawns", "result"]
    },
    "artifact_stage": { "type": ["string", "null"], "enum": ["DESIGN", "PLAN", "IMPLEMENTATION", null] },
    "artifact_path": { "type": ["string", "null"], "minLength": 1 },
    "source_github_repository_id": { "type": ["string", "null"] },
    "source_github_repository_full_name": { "type": ["string", "null"] },
    "current_remote_ref": { "type": ["string", "null"] },
    "local_head_sha": { "type": ["string", "null"] },
    "remote_head_sha": { "type": ["string", "null"] },
    "sync_status": { "enum": ["SYNCED", "SYNC_PENDING", "RECONCILIATION_REQUIRED", null] },
    "push_status": { "enum": ["NOT_ATTEMPTED", "SUCCEEDED", "FAILED", null] },
    "remote_verification": { "enum": ["NOT_ATTEMPTED", "VERIFIED", "UNAVAILABLE", "FAILED", null] },
    "publication_authority": { "enum": ["PUBLICATION_CANDIDATE_ONLY", "CONFIRMED_PUBLICATION", null] },
    "state_revision": {
      "type": ["integer", "null"],
      "minimum": 0
    },
    "execution": {
      "type": ["string", "array", "object", "null"]
    },
    "changed": {
      "type": ["string", "array", "object", "null"]
    },
    "verify": {
      "type": ["string", "array", "object", "null"]
    },
    "evidence_refs": {
      "type": "array",
      "items": {"type": "string"}
    },
    "deviations": {
      "type": ["string", "array", "object", "null"]
    },
    "blockers": {
      "type": ["string", "array", "object", "null"]
    },
    "git": {
      "type": ["object", "null"],
      "properties": {
        "base_sha": {"type": ["string", "null"]},
        "implementation_sha": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    },
    "git_base_sha": {
      "type": ["string", "null"]
    },
    "implementation_sha": {
      "type": ["string", "null"]
    },
    "parallel_batch": {
      "type": ["string", "array", "object", "null"]
    },
    "execution_unit": {
      "type": ["string", "array", "object", "null"]
    },
    "observability_fitness": {
      "type": ["string", "array", "object", "null"]
    },
    "extension_evidence_refs": {
      "type": ["string", "array", "object", "null"]
    },
    "next_gpt_action": {
      "type": ["string", "array", "object", "null"]
    },
    "completion_evidence": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "execution_state": {"enum": ["COMPLETED", "INCOMPLETE", "BLOCKED"]},
        "process_completed": {"type": "boolean"}, "exit_code": {"type": ["integer", "null"]},
        "intended_scope": {"type": "array", "maxItems": 100, "items": {"type": "string"}},
        "executed_scope": {"type": "array", "maxItems": 100, "items": {"type": "string"}},
        "test_files_expected": {"type": ["integer", "null"], "minimum": 0}, "test_files_executed": {"type": ["integer", "null"], "minimum": 0},
        "test_count": {"type": ["integer", "null"], "minimum": 0}, "failure_count": {"type": ["integer", "null"], "minimum": 0}, "error_count": {"type": ["integer", "null"], "minimum": 0},
        "validators_expected": {"type": "array", "maxItems": 50, "uniqueItems": true, "items": {"type": "string"}},
        "validators_completed": {"type": "array", "maxItems": 50, "uniqueItems": true, "items": {"type": "string"}},
        "blocker_evidence_refs": {"type": "array", "maxItems": 50, "items": {"type": "string"}}
      }
    },
    "completion_gate": {
      "enum": [
        "NONE",
        "GPT_DECISION",
        "USER_APPROVAL"
      ]
    }
  },
  "allOf": [
    {
      "not": { "required": ["message_type"] }
    },
    {
      "if": {
        "properties": { "result_message_type": { "enum": ["EXECUTION_INSTRUCTION", "REVIEW_REQUEST", "FIX_INSTRUCTION", "APPROVAL_REQUEST", "RECONCILIATION_REQUEST", "INFORMATION_ONLY", "PROJECT_CONTEXT_BOOTSTRAP", "WORK_UNIT", "IMPLEMENTATION"] } },
        "required": ["result_message_type"]
      },
      "then": { "not": {} }
    },
    {
      "if": { "properties": { "result_message_type": { "const": "APPROVAL_RESULT" } }, "required": ["result_message_type"] },
      "then": {
        "propertyNames": { "enum": ["kernel_version", "schema_version", "project_id", "work_unit_id", "extension", "status", "return_to_gpt_required", "source_project_context_id", "source_project_name", "framework_version", "result_message_type", "result_id", "decision", "approved_instruction", "response_to_instruction_id", "responder_role", "return_role", "review_target_revision", "finding_ids", "fix_round", "remediation_decision_ref", "protocol_error", "role_observation", "artifact_stage", "artifact_path", "source_github_repository_id", "source_github_repository_full_name", "current_remote_ref", "local_head_sha", "remote_head_sha", "sync_status", "push_status", "remote_verification", "publication_authority", "state_revision", "execution", "changed", "verify", "evidence_refs", "deviations", "blockers", "git", "git_base_sha", "implementation_sha", "parallel_batch", "execution_unit", "observability_fitness", "extension_evidence_refs", "next_gpt_action", "completion_evidence", "completion_gate"] },
        "required": ["result_id", "result_message_type", "responder_role", "status", "decision", "response_to_instruction_id", "approved_instruction", "evidence_refs", "completion_gate", "remote_verification", "completion_evidence"],
        "properties": {
          "result_id": { "type": "string", "minLength": 1 },
          "responder_role": { "const": "USER_APPROVER" }, "status": { "const": "PASS" },
          "decision": { "enum": ["APPROVE", "REJECT"] }, "response_to_instruction_id": { "type": "string", "format": "uuid" },
          "approved_instruction": { "type": "object" },
          "evidence_refs": { "const": [] }, "completion_gate": { "const": "NONE" },
          "remote_verification": { "const": "NOT_ATTEMPTED" }, "completion_evidence": { "const": null },
          "publication_authority": { "const": null }, "sync_status": { "const": null }, "remote_head_sha": { "const": null }
        },
        "allOf": [
          { "not": { "required": ["approval_evidence_ref"] } },
          { "not": { "required": ["evidence_commit_sha"] } },
          { "not": { "required": ["blob_sha"] } }
        ]
      },
      "else": {
        "if": { "properties": {"status": {"const": "PASS"}}, "required": ["status"] },
        "then": { "required": ["remote_verification"], "properties": {"remote_verification": {"const": "VERIFIED"}} }
      }
    },
    {
      "if": {
        "properties": {"sync_status": {"const": "SYNCED"}},
        "required": ["sync_status"]
      },
      "then": {
        "required": ["remote_verification", "publication_authority", "remote_head_sha", "evidence_refs"],
        "properties": {
          "remote_verification": {"const": "VERIFIED"},
          "publication_authority": {"const": "CONFIRMED_PUBLICATION"},
          "remote_head_sha": {"type": "string", "minLength": 1},
          "evidence_refs": {"minItems": 1}
        }
      }
    },
    {
      "if": {
        "properties": {"publication_authority": {"const": "PUBLICATION_CANDIDATE_ONLY"}},
        "required": ["publication_authority"]
      },
      "then": {
        "properties": {
          "status": {"not": {"const": "PASS"}},
          "sync_status": {"not": {"const": "SYNCED"}}
        }
      }
    },
    {
      "if": {
        "properties": {"return_to_gpt_required": {"const": true}},
        "required": ["return_to_gpt_required"]
      },
      "then": {
        "required": ["source_project_context_id", "source_project_name", "framework_version"]
      }
    },
    {
      "if": {
        "properties": { "result_message_type": { "type": "string", "not": { "const": "APPROVAL_RESULT" } }, "status": {"const": "PASS"}},
        "required": ["result_message_type", "status"]
      },
      "then": { "required": ["completion_evidence"], "properties": { "completion_evidence": { "type": "object", "required": ["execution_state", "process_completed", "exit_code", "intended_scope", "executed_scope", "test_files_expected", "test_files_executed", "test_count", "failure_count", "error_count", "validators_expected", "validators_completed", "blocker_evidence_refs"] } } }
    }
  ]
}
