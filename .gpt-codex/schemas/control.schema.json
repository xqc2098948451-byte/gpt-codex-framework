{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gpt-codex/control-v1",
  "title": "GPT-Codex CONTROL",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "kernel_version",
    "schema_version",
    "project_id",
    "governance_profile",
    "framework",
    "roots",
    "extensions",
    "permissions",
    "complexity"
  ],
  "properties": {
    "kernel_version": {
      "const": "2.0.0"
    },
    "schema_version": {
      "const": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 3
    },
    "github": {
      "type": "object",
      "required": ["repository_id", "repository_full_name", "default_branch"],
      "properties": {
        "repository_id": {"type": "string", "minLength": 1},
        "repository_full_name": {"type": "string", "minLength": 1},
        "default_branch": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "governance_profile": {
      "enum": [
        "MINIMAL",
        "STANDARD",
        "EXTENDED"
      ]
    },
    "framework": {
      "type": "object",
      "required": [
        "adopted_version",
        "last_evaluated_version",
        "evaluation_result"
      ],
      "properties": {
        "evaluation_result": {
          "enum": [
            "ADOPTED",
            "NO_ACTION",
            "OPTIONAL_REUSE",
            "RECOMMENDED_UPGRADE",
            "REQUIRED_MIGRATION",
            "CONFLICT"
          ]
        }
      }
    },
    "execution_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy_profile_id", "gpt_orchestrator_strategy", "codex_implementer_strategy", "codex_reviewer_strategy", "task_splitting", "review_policy", "instruction_policy", "result_return_policy"],
      "properties": {
        "strategy_profile_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "gpt_orchestrator_strategy": {"type": "string", "minLength": 1, "maxLength": 128},
        "codex_implementer_strategy": {"type": "string", "minLength": 1, "maxLength": 128},
        "codex_reviewer_strategy": {"type": "string", "minLength": 1, "maxLength": 128},
        "task_splitting": {"const": "PROJECT_DETERMINED"},
        "review_policy": {"enum": ["RISK_OR_MILESTONE", "EXPLICIT"]},
        "instruction_policy": {"const": "REFERENCE_FIRST"},
        "result_return_policy": {"const": "DURABLE_REF_FIRST"}
      }
    },
    "roots": {
      "type": "object",
      "required": [
        "project_role",
        "framework_role",
        "framework_kernel_access",
        "framework_builtins_access",
        "harvest_namespace"
      ],
      "properties": {
        "project_role": {
          "const": "AUTHORITATIVE"
        },
        "framework_role": {
          "const": "ADVISORY"
        },
        "framework_kernel_access": {
          "const": "READ_ONLY"
        },
        "framework_builtins_access": {
          "const": "READ_ONLY"
        },
        "harness_root": {
          "type": "string",
          "minLength": 1
        },
        "product_roots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "deploy_roots": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "production_excludes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "extensions": {
      "type": "object",
      "required": [
        "skills",
        "guardrails",
        "fitness"
      ]
    },
    "permissions": {
      "type": "object"
    },
    "complexity": {
      "type": "object"
    }
  }
}
