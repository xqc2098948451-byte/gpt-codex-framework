{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gpt-codex/work-unit-v1",
  "title": "GPT-Codex Work Unit",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "kernel_version",
    "schema_version",
    "project_id",
    "work_unit_id",
    "goal",
    "scope",
    "acceptance",
    "selected_extensions",
    "state",
    "basis_state_revision"
  ],
  "properties": {
    "kernel_version": {
      "const": "2.0.0"
    },
    "schema_version": {
      "const": 1
    },
    "work_unit_id": {
      "type": "string"
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "basis_state_revision": {
      "type": "integer",
      "minimum": 0
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owned_paths"],
      "properties": {
        "owned_paths": {
          "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ScopeSelector",
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*[*?\\[\\]])(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?:[^/]+/)*[^/]+/?$"
          }
        },
        "excluded_paths": {
          "type": "array", "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ScopeSelector",
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*[*?\\[\\]])(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?:[^/]+/)*[^/]+/?$"
          }
        }
      }
    },
    "artifact_refs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "design": {"$ref": "#/$defs/ImmutableArtifactRef"},
        "plan": {"$ref": "#/$defs/ImmutableArtifactRef"}
      }
    },
    "directory_creations": {
      "type": "array", "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "purpose", "owner", "content_type", "authority_type", "lifetime", "consumer_visible", "release_visible", "cleanup_policy"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*[*?\\[\\]])(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?:[^/]+/)*[^/]+/?$"
          },
          "purpose": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "content_type": {"type": "string", "minLength": 1},
          "authority_type": {"type": "string", "minLength": 1},
          "lifetime": {"const": "DURABLE"},
          "consumer_visible": {"type": "boolean"},
          "release_visible": {"type": "boolean"},
          "cleanup_policy": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "ScopeSelector": {
      "type": "string",
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*[*?\\[\\]])(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)(?:[^/]+/)*[^/]+/?$"
    },
    "ImmutableArtifactRef": {
      "type": ["object", "null"],
      "required": ["path", "sha"],
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"}
      }
    }
  }
}
