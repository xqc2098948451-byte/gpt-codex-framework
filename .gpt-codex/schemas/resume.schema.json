{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gpt-codex/resume-v1",
  "title": "GPT-Codex Resume",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authority",
    "project_id",
    "project_context_id",
    "repository_id",
    "checkpoint",
    "working_set",
    "next_required_reads",
    "invalidated_context"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "authority": {"const": "DERIVED_CACHE"},
    "project_id": {"type": "string", "minLength": 1},
    "project_context_id": {"type": "string", "minLength": 1},
    "repository_id": {"type": ["string", "null"]},
    "checkpoint": {"type": "object"},
    "working_set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hot_modules", "hot_files"],
      "properties": {
        "hot_modules": {"type": "array", "items": {"type": "string"}},
        "hot_files": {"type": "array", "items": {"type": "string"}}
      }
    },
    "next_required_reads": {"type": "array", "items": {"type": "string"}},
    "invalidated_context": {"type": "array", "items": {"type": "string"}}
  }
}
